# Strategy module env vars — mounted at /app/src/lib/strategy/.env
# (FileLoader._load_env_vars expects this exact path)
#
# Filled by scripts/00-bootstrap-cerai.sh from the repo-root .env.
# Do not edit values directly here — edit .env at the repo root.

DEFAULT_VALUES_PATH=data/defaults.json

# Judge — OpenRouter, OpenAI-compatible
LLM_AS_JUDGE_MODEL=google/gemini-3.1-pro-preview
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Target — Sarvam-30B
# SARVAM_MAX_TOKENS must be >= 1024: reasoning trace consumes tokens before content.
# SARVAM_REASONING_EFFORT must be set; without it Sarvam returns content=null.
SARVAM_API_KEY=${SARVAM_API_KEY}
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-30b
SARVAM_REASONING_EFFORT=low
SARVAM_MAX_TOKENS=2048
SARVAM_SEED=42

HF_TOKEN=${HF_TOKEN}

# Route llm_judge_positive through OpenRouter instead of Ollama
# (qwen3:32b exceeds typical RAM budgets). Picked up by patched llm_judge.py.
LLM_AS_JUDGE_PROVIDER=openrouter
LLM_AS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
LLM_AS_JUDGE_API_KEY_ENV=OPENROUTER_API_KEY

# Pin Google Vertex for the Gemma baseline to match the direct-API run's
# single-provider/single-quantization comparison; fallbacks disabled.
OPENROUTER_PROVIDER_ORDER=Google
OPENROUTER_ALLOW_FALLBACKS=false

# sarvam-ai container URL (only consumed if the 'sarvam' compose profile is active)
GPU_URL=http://sarvam-ai:16000

# Empty placeholders — getenv("") not None
OLLAMA_URL=
GEMINI_API_KEY=
PERSPECTIVE_API_KEY=
